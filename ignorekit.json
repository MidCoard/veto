{
  "version": 1,
  "name": "veto",
  "preset": "java-gradle",
  "provider": {
    "name": "local"
  },
  "components": [
    "language/python",
    "local/ai-claude",
    "local/assistant-artifacts"
  ],
  "exclude": [],
  "custom": [
    "target/",
    "/vault/",
    "/work/",
    "/audit/",
    "/models/",
    "/veto-core/audit/",
    "veto-core/training/data/*.json",
    "veto-core/training/data/*.jsonl",
    "veto-core/training/.hf-cache/",
    "veto-core/training/.pip-cache/",
    "veto-core/training/.tmp/",
    "veto-core/training/.venv/",
    "veto-core/training/models/",
    "plans/",
    "scripts/",
    "docs/",
    "ARCHITECTURE.md",
    ".playwright-mcp/",
    "prompt-dump/"
  ],
  "addons": {}
}
