{
  "version": 1,
  "name": "veto",
  "preset": "java-gradle",
  "provider": {
    "name": "local"
  },
  "components": [
    "language/python",
    "local/ai-claude"
  ],
  "exclude": [
    "editor/vscode"
  ],
  "custom": [
    "/work/",
    "/models/",
    "/release/",
    "/veto-core/audit/",
    "veto-core/training/data/*.json",
    "veto-core/training/data/*.jsonl",
    "veto-core/training/.hf-cache/",
    "veto-core/training/.pip-cache/",
    "veto-core/training/.tmp/",
    "veto-core/training/.venv/",
    "veto-core/training/models/",
    "veto-core/training/*.jsonl",
    "veto-core/models/",
    "veto-core/benchmarks/agentdojo/.venv/",
    "veto-core/benchmarks/agentdojo/workspace/",
    "veto-core/benchmarks/agentdojo/runs/",
    "/conversion_log.jsonl",
    "/training_log.jsonl",
    "plans/",
    "/AGENTS.md",
    "scripts/",
    "ARCHITECTURE.md",
    ".veto_history"
  ],
  "addons": {}
}
